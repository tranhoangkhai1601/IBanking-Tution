# Just for dev local test while develope

# Server
SERVER_ENV=development
SERVER_PORT=8080

PROJECT_NAME="IBanking API"
PROJECT_VERSION="1.0.0"

# Service URL
AUTH_SERVICE_URL=http://auth_service:8080
PAYMENT_SERVICE_URL=http://payment_service:8080
CUSTOMER_SERVICE_URL=http://customer_service:8080
TUITION_SERVICE_URL=http://tuition_service:8080

# JWT
JWT_TOKEN=<change-me-with-random-string>
ALGORITHM="RS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=60


# Postgres
DB_HOST=postgres
DB_USER=ibanking
DB_PASS=ibanking
DB_NAME=test_db
DB_PORT=5432
DB_PORT_HOST=5433
POSTGRES_MULTIPLE_DATABASES=auth_db,payment_db,customer_db,tuition_db

# Redis
REDIS_PASS=ibanking
